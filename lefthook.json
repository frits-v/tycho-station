{
  "commit-msg": {
    "commands": {
      "conventional": { "run": "cargo run -q -p xtask -- check-commit-msg {1}" }
    }
  },
  "pre-commit": {
    "commands": {
      "fmt": { "run": "cargo run -q -p xtask -- fmt" }
    }
  },
  "pre-push": {
    "commands": {
      "clippy": { "run": "cargo run -q -p xtask -- clippy" },
      "test": { "run": "cargo run -q -p xtask -- test" },
      "workflows": { "glob": ".github/**", "run": "cargo run -q -p xtask -- workflows --offline" },
      "codeql": { "glob": ".github/**", "run": "cargo run -q -p xtask -- codeql" },
      "opengrep": { "glob": ["**/*.rs", "opengrep/**"], "run": "cargo run -q -p xtask -- opengrep" }
    }
  }
}
