{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create *)",
            "command": "cargo run -q -p xtask -- hook pre-tool-use"
          },
          {
            "type": "command",
            "if": "Bash(gh pr new *)",
            "command": "cargo run -q -p xtask -- hook pre-tool-use"
          },
          {
            "type": "command",
            "if": "Bash(gh pr edit *)",
            "command": "cargo run -q -p xtask -- hook pre-tool-use"
          },
          {
            "type": "command",
            "if": "Bash(gh pr update-branch *)",
            "command": "cargo run -q -p xtask -- hook pre-tool-use"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cargo run -q -p xtask -- hook post-tool-use"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(cargo:*)",
      "Bash(mise:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh run:*)"
    ]
  }
}
